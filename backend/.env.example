# HR Hub Backend Environment Configuration Example
# Duplicate this file to .env and configure values before starting the application

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Mandatory Secret Key for Signing Authentication Tokens (JWT)
# Use a random string with at least 32 characters in production.
# Required in production; application will fail to start if omitted.
JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_chars

# MongoDB Database Connection String
# Leave blank in development to use embedded in-memory MongoDB.
# In production, provide your MongoDB Atlas cluster URI.
MONGODB_URI=

# Ephemeral In-Memory Database Flag
# When true, permits fallback to in-memory MongoDB if external MONGODB_URI fails.
ALLOW_IN_MEMORY_DB=false

# Allowed Frontend Origins for CORS (comma-separated if multiple)
CLIENT_URL=http://localhost:5173,http://localhost:5000

# Protect Destructive Database Purge Endpoints
# Set to true only in dedicated sandbox testing environments.
ENABLE_DESTRUCTIVE_OPERATIONS=false
