# HR Hub Root Environment Template
# See backend/.env.example for detailed backend configurations

PORT=5000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret_key_minimum_32_chars
MONGODB_URI=
ALLOW_IN_MEMORY_DB=false
CLIENT_URL=http://localhost:5173,http://localhost:5000
ENABLE_DESTRUCTIVE_OPERATIONS=false
